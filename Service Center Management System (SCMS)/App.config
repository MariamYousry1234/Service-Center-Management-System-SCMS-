<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
   
	</startup>

	

<appSettings>
	<add key="ApplicationName" value="SCMSApp"/>
	<add key="EncrytDecryptKey" value="1234567890123456"/>
    <add key="CurrentUserKeyPath" value="HKEY_CURRENT_USER\SOFTWARE\SCMS"/>
	<add key="LocalMachineKeyPath" value="HKEY_LOCAL_MACHINE\SOFTWARE\SCMS"/>
   <add key="KeyPathWithoutRegistryHive" value="SOFTWARE\SCMS"/>
	<add key="NumberOfRowsEachPage" value="10"/>
	<add key="ImagesFolderPath" value="C:\SCMSRepairOrderImages\"/>
</appSettings>





<connectionStrings>
	<add name ="SCMSConnectionString" connectionString="Server=. ;Database=SCMS ;User ID=sa;Password=123456"/>
</connectionStrings>

</configuration>